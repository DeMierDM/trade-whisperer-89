                      <div>
                        <Label>Bot Name</Label>
                        <Input
                          placeholder="My Trading Bot"
                          className="mt-1"
                          value={paperTradingName}
                          onChange={(e) => setPaperTradingName(e.target.value)}
                        />
                      </div>

                      <div>
                        <Label>Strategy</Label>
                        <select
                          className="w-full mt-1 p-2 rounded-lg bg-secondary border border-border text-foreground"
                          value={config.strategy}
                          onChange={(e) => setConfig({ ...config, strategy: e.target.value })}
                          aria-label="Paper Trading Strategy"
                        >
                          <option value="rsi-vwap-morning-session">RSI-VWAP Morning Session</option>
                          <option value="rsi-vwap-fusion">RSI-VWAP Fusion</option>
                          <option value="rsi-vwap-adaptive-tod">RSI-VWAP Adaptive</option>
                        </select>
                      </div>

                      <div>
                        <Label>Symbol</Label>
                        <Input
                          placeholder="SPY"
                          className="mt-1"
                          value={config.symbol}
                          onChange={(e) => setConfig({ ...config, symbol: e.target.value })}
                        />
                      </div>

                      <div>
                        <Label>Position Size ($)</Label>
                        <Input
                          type="number"
                          className="mt-1"
                          value={paperTradingPositionSize}
                          onChange={(e) => setPaperTradingPositionSize(e.target.value)}
                          placeholder="1000"
                        />
                      </div>

                      <div>
                        <Label>Max Positions</Label>
                        <Input
                          type="number"
                          className="mt-1"
                          value={paperTradingMaxPositions}
                          onChange={(e) => setPaperTradingMaxPositions(e.target.value)}
                          placeholder="3"
                        />
                      </div>

                      <div className="grid grid-cols-2 gap-2">
                        <div>
                          <Label>Stop Loss (%)</Label>
                          <Input
                            type="number"
                            step="0.1"
                            className="mt-1"
                            value={paperTradingStopLoss}
                            onChange={(e) => setPaperTradingStopLoss(e.target.value)}
                            placeholder="20"
                          />
                        </div>
                        <div>
                          <Label>Take Profit (%)</Label>
                          <Input
                            type="number"
                            step="0.1"
                            className="mt-1"
                            value={paperTradingTakeProfit}
                            onChange={(e) => setPaperTradingTakeProfit(e.target.value)}
                            placeholder="50"
                          />
                        </div>
                      </div>

                      <Button
                        className="w-full mt-6 bg-gradient-primary shadow-glow"
                        onClick={handleCreateBot}
                        disabled={paperTradingLoading || !paperTradingName.trim()}
                      >
                        {paperTradingLoading ? (
                          <>
                            <AlertCircle className="w-4 h-4 mr-2 animate-spin" />
                            Creating Bot...
                          </>
                        ) : (
                          <>
                            <Play className="w-4 h-4 mr-2" />
                            Create Paper Bot
                          </>
                        )}
                      </Button>
                    </>
                  )}

                  {/* Existing Bots */}
                  {bots && bots.length > 0 && (
                    <div className="space-y-3">
                      {bots.map((bot) => (
                        <div key={bot.id} className="p-3 rounded-lg bg-secondary/50 border border-border">
                          <div className="flex items-center justify-between mb-2">
                            <h4 className="font-semibold">{bot.name}</h4>
                            <Badge variant={bot.status === 'active' || bot.status === 'running' ? 'default' : 'secondary'}>
                              {bot.status}
                            </Badge>
                          </div>
                          <div className="text-xs text-muted-foreground mb-2">
                            {bot.strategy} • {bot.symbol}
                          </div>
                          <div className="flex gap-2">
                            {bot.status === 'stopped' ? (
                              <Button
                                size="sm"
                                onClick={() => handleStartBot(bot.id.toString())}
                                className="flex-1"
                              >
                                <Play className="w-3 h-3 mr-1" />
                                Start
                              </Button>
                            ) : (
                              <Button
                                size="sm"
                                variant="destructive"
                                onClick={() => handleStopBot(bot.id.toString())}
                                className="flex-1"
                              >
                                <Square className="w-3 h-3 mr-1" />
                                Stop
                              </Button>
                            )}
                            <Button
                              size="sm"
                              variant="outline"
                              onClick={() => handleDeleteBot(bot.id.toString())}
                            >
                              Delete
                            </Button>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </Card>

              {/* Live Paper Trading Dashboard */}
              <Card className="col-span-8 p-6 bg-gradient-card border-border shadow-card">
                <div className="flex items-center justify-between mb-4">
                  <h2 className="text-xl font-semibold">Paper Account Dashboard</h2>
                  <Badge variant="outline">
                    Account Value: ${paperMetrics?.total_value?.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) || '100,000.00'}
                  </Badge>
                </div>

                <div className="space-y-4">
                  {/* Account Stats */}
                  <div className="grid grid-cols-4 gap-4">
                    {[
                      { 
                        label: "Today's P&L", 
                        value: `$${paperMetrics?.daily_pnl?.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) || '0.00'}`,
                        positive: paperMetrics?.daily_pnl ? paperMetrics.daily_pnl > 0 : null 
                      },
                      { 
                        label: "Open Positions", 
                        value: paperPositions?.length?.toString() || "0", 
                        positive: null 
                      },
                      { 
                        label: "Win Rate", 
                        value: paperMetrics?.win_rate ? `${(paperMetrics.win_rate * 100).toFixed(1)}%` : "0%", 
                        positive: paperMetrics?.win_rate ? paperMetrics.win_rate > 0.5 : null 
                      },
                      { 
                        label: "Trades Today", 
                        value: paperMetrics?.total_trades?.toString() || "0", 
                        positive: null 
                      },
                    ].map((stat) => (
                      <div key={stat.label} className="p-3 rounded-lg bg-secondary/50 border border-border">
                        <p className="text-xs text-muted-foreground">{stat.label}</p>
                        <p className={`text-xl font-bold mt-1 ${
                          stat.positive === true ? 'text-green-500' : 
                          stat.positive === false ? 'text-red-500' : ''
                        }`}>
                          {stat.value}
                        </p>
                      </div>
                    ))}
                  </div>

                  {/* Open Positions */}
                  <div>
                    <h3 className="text-lg font-semibold mb-3">Open Positions</h3>
                    {paperPositions && paperPositions.length > 0 ? (
                      <div className="space-y-2 max-h-48 overflow-y-auto">
                        {paperPositions.map((position) => (
                          <div key={position.id} className="p-3 rounded-lg bg-secondary/30 border border-border">
                            <div className="flex items-center justify-between">
                              <div>
                                <span className="font-semibold">{position.contract_symbol}</span>
                                <Badge variant={position.side === 'long' ? 'default' : 'destructive'} className="ml-2">
                                  {position.side.toUpperCase()}
                                </Badge>
                              </div>
                              <div className="text-right">
                                <div className={`font-bold ${
                                  position.unrealized_pnl >= 0 ? 'text-green-500' : 'text-red-500'
                                }`}>
                                  ${position.unrealized_pnl.toFixed(2)}
                                </div>
                                <div className="text-xs text-muted-foreground">
                                  {position.quantity} contracts @ ${position.avg_fill_price.toFixed(2)}
                                </div>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div className="p-8 text-center text-muted-foreground rounded-lg bg-secondary/30 border border-border">
                        {bots && bots.some(bot => bot.status === 'active') ? 
                          'No open positions. Bot is monitoring for signals...' :
                          'No open positions. Start a bot to begin paper trading.'
                        }
                      </div>
                    )}
                  </div>

                  {/* Recent Trades */}
                  <div>
                    <h3 className="text-lg font-semibold mb-3">Recent Trades</h3>
                    {paperTrades && paperTrades.length > 0 ? (
                      <div className="space-y-2 max-h-64 overflow-y-auto">
                        {paperTrades.slice(0, 10).map((trade) => (
                          <div key={trade.id} className="p-3 rounded-lg bg-secondary/30 border border-border">
                            <div className="flex items-center justify-between">
                              <div>
                                <span className="font-semibold">{trade.contract_symbol}</span>
                                <Badge variant={trade.side === 'buy' ? 'default' : 'destructive'} className="ml-2">
                                  {trade.side.toUpperCase()}
                                </Badge>
                                <div className="text-xs text-muted-foreground mt-1">
                                  {new Date(trade.timestamp).toLocaleTimeString()}
                                </div>
                              </div>
                              <div className="text-right">
                                <div className="font-bold">
                                  ${(trade.quantity * trade.price).toFixed(2)}
                                </div>
                                <div className="text-xs text-muted-foreground">
                                  {trade.quantity} @ ${trade.price.toFixed(2)}
                                </div>
                                {trade.reason && (
                                  <div className="text-xs text-blue-400">
                                    {trade.reason}
                                  </div>
                                )}
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    ) : (
                      <div className="p-8 text-center text-muted-foreground rounded-lg bg-secondary/30 border border-border">
                        {bots && bots.some(bot => bot.status === 'active') ? 
                          'No trades executed yet. Bot will trade when signals are detected.' :
                          'No trades yet. Start a bot to begin trading.'
                        }
                      </div>
                    )}
                  </div>
                </div>
              </Card>
            </div>
          </TabsContent>
        </Tabs>
      </div>
    </div>
  );
};

export default Backtesting;
