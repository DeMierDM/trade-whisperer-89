# ======================================
# Trade Whisperer Environment Configuration
# ======================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# ======================================
# ALPACA API CONFIGURATION
# ======================================
# Get your keys from: https://alpaca.markets/
# CRITICAL: Live keys required for market data (paper keys don't work for historical data)

ALPACA_LIVE_API_KEY=your_live_api_key_here
ALPACA_LIVE_API_SECRET=your_live_api_secret_here

# Legacy support (deprecated, use LIVE keys above)
ALPACA_PAPER_API_KEY=your_paper_api_key_here
ALPACA_PAPER_API_SECRET=your_paper_api_secret_here

# ======================================
# DATABASE CONFIGURATION
# ======================================
# PostgreSQL connection for persistent storage

# Local Development (Docker)
DATABASE_URL=postgresql://trader:tradingpass123@postgres:5432/trading_db

# Production (override with actual connection string)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ======================================
# API SERVER CONFIGURATION
# ======================================
# Port configuration for all microservices

PORT=3001                    # Main API Server (market data, WebSocket, auth)
BACKTESTING_PORT=3002        # Backtesting Server (strategy testing)
OPTIONS_DATA_PORT=3003       # Options Data Service (options chains, Greeks)
DATA_BUS_PORT=3004           # Data Bus Manager (central data hub)
PAPER_TRADING_PORT=3005      # Paper Trading Service (live bots)

# External Service URLs
API_SERVER_URL=http://localhost:3001
BACKTESTING_SERVER_URL=http://localhost:3002
OPTIONS_DATA_SERVER_URL=http://localhost:3003
DATA_BUS_URL=http://localhost:3004
PAPER_TRADING_URL=http://localhost:3005

# ======================================
# FRONTEND CONFIGURATION
# ======================================
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_DATA_BUS_WS_URL=ws://localhost:3004

# ======================================
# FEATURE FLAGS
# ======================================
# Toggle features on/off for testing and gradual rollouts

ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false       # CRITICAL: Keep false until fully tested
ENABLE_OPTIONS_TRADING=true
ENABLE_BACKTESTING=true
ENABLE_OPTIMIZATION=true
ENABLE_AI_ASSISTANT=true
ENABLE_ADVANCED_CHARTS=true
ENABLE_DATA_BUS=true            # NEW: Central data management

# ======================================
# RISK MANAGEMENT CONFIGURATION
# ======================================
# Global risk controls to prevent catastrophic losses

MAX_DAILY_LOSS_PERCENT=2         # Kill switch at 2% account loss
MAX_POSITION_SIZE_PERCENT=10     # Max 10% of account per position
MAX_OPEN_POSITIONS=5             # Max concurrent positions
STOP_LOSS_PERCENT=50             # Default 50% stop loss on options
TAKE_PROFIT_PERCENT=100          # Default 100% take profit

# ======================================
# TRADING CONFIGURATION
# ======================================
# Strategy and execution parameters

DEFAULT_STRATEGY=havwap          # Default strategy for new bots
DEFAULT_SYMBOL=SPY               # Default underlying for options
TRADING_HOURS_ONLY=true          # Only trade during market hours
SESSION_START_TIME=09:30         # Market open (ET)
SESSION_END_TIME=15:50           # Close positions before close (ET)

# Options-specific
DEFAULT_DTE=0                    # 0DTE trading by default
MAX_SPREAD_PERCENT=25            # Filter wide spreads
MIN_OPTION_VOLUME=100            # Minimum daily volume
MIN_OPTION_DELTA=0.2             # Minimum delta for entries

# ======================================
# DATA COLLECTION & STORAGE
# ======================================
# CSV logging and data persistence

ENABLE_CSV_LOGGING=true
DATA_DIRECTORY=/app/data
LOG_LEVEL=info                   # Options: debug, info, warn, error

# ======================================
# PERFORMANCE & OPTIMIZATION
# ======================================
# System performance tuning

WORKER_THREADS=4                 # Parallel backtest workers
CACHE_TTL_SECONDS=300            # 5 minute cache for market data
RATE_LIMIT_PER_MINUTE=200        # API rate limiting
WEBSOCKET_PING_INTERVAL=30000    # 30 second keepalive
DATABASE_POOL_SIZE=20            # Max DB connections

# ======================================
# SECURITY
# ======================================
# Application security settings

JWT_SECRET=change_this_to_a_secure_random_string_minimum_32_characters
SESSION_SECRET=change_this_to_another_secure_random_string
CORS_ORIGIN=http://localhost:8080
ENCRYPTION_KEY=change_this_to_yet_another_secure_random_string

# ======================================
# MONITORING & ALERTS
# ======================================
# Observability and notifications

ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_ALERTS=true
SLACK_WEBHOOK_URL=                # Optional: Slack notifications
DISCORD_WEBHOOK_URL=              # Optional: Discord notifications

# Email Alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ======================================
# DEVELOPMENT SETTINGS
# ======================================
# Only used in development environment

NODE_ENV=development              # Options: development, production, test
DEBUG_MODE=false
MOCK_MARKET_DATA=false           # Use fake data instead of live API
SKIP_AUTH=false                  # Bypass authentication (dev only)

# ======================================
# EXTERNAL SERVICES
# ======================================
# Third-party integrations

# TradingView (optional advanced charting)
TRADINGVIEW_API_KEY=

# Optionally use Polygon.io for backup market data
POLYGON_API_KEY=

# AWS S3 for backup storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ======================================
# DOCKER CONFIGURATION
# ======================================
# Docker-specific settings

COMPOSE_PROJECT_NAME=trade-whisperer
DOCKER_BUILDKIT=1
POSTGRES_USER=trader
POSTGRES_PASSWORD=tradingpass123
POSTGRES_DB=trading_db

# ======================================
# VALIDATION
# ======================================
# These values are checked on startup
# System will fail fast if critical config is missing

REQUIRE_ALPACA_KEYS=true
REQUIRE_DATABASE=true
REQUIRE_DATA_BUS=true
