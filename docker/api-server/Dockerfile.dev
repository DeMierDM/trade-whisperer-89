FROM node:18-alpine

WORKDIR /app

# Copy package files for dependency installation
COPY package*.json ./

# Install dependencies including nodemon for development
RUN npm install

# Install nodemon globally for development hot reload
RUN npm install -g nodemon

# Copy source code
COPY . .

# Expose port
EXPOSE 3001

# Start development server with nodemon hot reload
CMD ["npm", "run", "dev"]